// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    //url      = "postgresql://postgres:123456@localhost:5432/postgres?schema=foro_social"
}

model Usuarios {
    id         String  @id @default(uuid())
    name       String
    apellido   String
    usuario    String
    email      String  @unique
    password   String
    confirmed  Boolean @default(false)
    user_token String?
    active     Boolean @default(true)
}

model Token {
    id         Int      @id @default(autoincrement())
    token      String   @unique
    dateCreate DateTime @default(now())
    idUsuario  String
}

model Comments {
    idComment     Int       @id @default(autoincrement())
    idPublication Int
    content       String
    likes         Int       @default(0)
    idReply       Int       @default(0)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime? @updatedAt
    idUser        String
    active        Boolean   @default(true)
}

model Publications {
    idPublication Int       @id @default(autoincrement())
    title         String
    content       String
    category      String?
    tags          String[]
    likes         Int       @default(0)
    isAnonymus    Boolean   @default(false)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime? @updatedAt
    idUser        String
    active        Boolean   @default(true)
}

model Like {
    idLike        String   @id @default(uuid())
    idPublication Int?
    idComment     Int?
    userId        String
    createdAt     DateTime @default(now())
}

model Report {
    id            String   @id @default(uuid())
    reason        String
    details       String?
    idPublication Int?
    userId        String
    createdAt     DateTime @default(now())
}

model SavedPost {
    id            String   @id @default(uuid())
    idPublication Int
    idUser        String
    createdAt     DateTime @default(now())
}

model Pais {
    id     Int    @id @default(autoincrement())
    nombre String
    codigo String
}

model Provincia {
    id     Int    @id @default(autoincrement())
    nombre String
    codigoPais String?
    idPais Int?
}

model CategoriaLogistica {
    id     Int    @id @default(autoincrement())
    nombre String
}

model Logistica {
    id          Int      @id @default(autoincrement())
    nombre      String
    descripcion String
    tipo        String
    imagen      String?
    tips        String?
    mejor_para  String?
    link_maps   String?
    idPais      Int
    idProvincia Int
    fecha       DateTime @default(now())
}
